# Copy to .env and fill in from your Entra app registration.
#
# AUTH_MODE=mock skips Microsoft entirely and signs in a fabricated user, so the
# AZURE_* / FLASK_* values below become optional. DEV/TEST ONLY.
# AUTH_MODE=entra
# MOCK_USER_NAME=Mock User
# MOCK_USER_EMAIL=mock.user@contoso.example
# MOCK_USER_ROLES=Dash.User,Admin
FLASK_SECRET_KEY=change-me-to-a-long-random-string
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-VALUE
# Must match a Web redirect URI registered in Entra exactly
REDIRECT_URI=http://localhost:8050/auth/redirect
POST_LOGOUT_URI=http://localhost:8050/

# --- production / gunicorn ---
# Number of reverse proxies in front of gunicorn (0 = none)
PROXY_HOPS=0
# Set to 1 when served over HTTPS
SESSION_COOKIE_SECURE=0
# Optional: shared session store for multiple hosts/containers
# REDIS_URL=redis://localhost:6379/0
# BIND=0.0.0.0:8050
# WEB_CONCURRENCY=4
